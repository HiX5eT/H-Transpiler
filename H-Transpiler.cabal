cabal-version:      3.0
name:               H-Transpiler
version:            0.1.0.0
license:            MIT
license-file:       LICENSE
author:             HıX5eT
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options: -Wall -threaded

executable H-Transpiler
    import:             warnings
    main-is:            Main.hs
    build-depends:      base ^>=4.20.2.0,
                        http-client,
                        http-client-tls,
                        aeson,
                        text,
                        bytestring,
                        scotty
    hs-source-dirs:     app
    default-language:   Haskell2010
